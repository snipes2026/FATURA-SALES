# Copy to .env and fill in. Used by Docker Compose AND by `npm run dev` / `npm run db:*`.

# --- Database --------------------------------------------------------------
# Strong random password, e.g.:  openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me-strong-password
# Only used when running the app/scripts OUTSIDE Docker (npm run dev).
# Inside Docker, compose builds the URL itself (host fatura-db:5432).
DATABASE_URL=postgres://fatura:change-me-strong-password@localhost:5433/fatura_desk
DB_POOL_MAX=10

# --- Auth ------------------------------------------------------------------
# Generate with:  npx auth secret   or   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# --- App -------------------------------------------------------------------
APP_DOMAIN=localhost
APP_URL=https://localhost
APP_PORT=3000
# Product images + company logo. Docker uses /data/uploads (named volume).
UPLOAD_DIR=./data/uploads

# --- Seed ------------------------------------------------------------------
# Initial password for the "admin" user (default Admin@123 if empty).
SEED_ADMIN_PASSWORD=
